import fs from 'fs-extra';

import path from 'path';

const snakeGames = {};

const sleep = ms => new Promise(r => setTimeout(r, ms));

export const NovaUltra = {

    command: 'ثعبان',

    description: 'لعبة الثعبان بمساحة 9x9 وسرعة تزداد كل 10 ثوانٍ.',

    elite: "off",

    group: true,

    prv: false,

    lock: "off"

};

export async function execute({ sock, msg, args }) {

    const from = msg.key.remoteJid;

    if (snakeGames[from] && snakeGames[from].gameRunning) {

        return await sock.sendMessage(from, { text: '⚠️ هناك لعبة ثعبان قيد التشغيل بالفعل في هذه الدردشة!' }, { quoted: msg });

    }

    // --- إعدادات اللعبة (9x9) ---

    const width = 9; 

    const height = 9; 

    const centerX = Math.floor(width / 2); // سيكون 4 (المنتصف تماماً للشبكة 0-8)

    const centerY = Math.floor(height / 2);

    snakeGames[from] = {

        snake: [{ x: centerX, y: centerY }, { x: centerX, y: centerY + 1 }], 

        food: { x: Math.floor(Math.random() * width), y: Math.floor(Math.random() * height) },

        direction: { x: 0, y: -1 }, 

        score: 0,

        moves: 0,

        startTime: Date.now(),

        gameRunning: true,

        messageKey: null

    };

    const game = snakeGames[from];

    const drawBoard = (currentWait) => {

        let board = `🎮 *لعبة الأفعى المتقدمة ${width}x${height}*\n\n`;

        board += `╔${"═".repeat(width * 2)}╗\n`;

        for (let y = 0; y < height; y++) {

            board += "║";

            for (let x = 0; x < width; x++) {

                const isFood = game.food.x === x && game.food.y === y;

                const isHead = game.snake[0].x === x && game.snake[0].y === y;

                const isBody = game.snake.slice(1).some(b => b.x === x && b.y === y);

                if (isHead) board += "🐍";

                else if (isBody) board += "🟩";

                else if (isFood) board += "🍎";

                else board += "⬜";

            }

            board += "║\n";

        }

        board += `╚${"═".repeat(width * 2)}╝\n\n`;

        board += `🏆 النقاط: ${game.score} | 📏 الطول: ${game.snake.length}\n`;

        board += `⏳ السرعة الحالية: ${(currentWait / 1000).toFixed(2)} ث/خطوة\n`;

        board += `⏱️ الوقت المار: ${Math.floor((Date.now() - game.startTime) / 1000)} ثانية\n\n`;

        board += `🔼 *التحكم:* (فوق، تحت، يمين، يسار)\n🛑 اكتب *انهاء* للانسحاب`;

        return board;

    };

    const initialMsg = await sock.sendMessage(from, { text: drawBoard(1500) });

    game.messageKey = initialMsg.key;

    const messageListener = async ({ messages }) => {

        const m = messages[0];

        if (!m.message || !game.gameRunning) return;

        const text = (m.message.conversation || m.message.extendedTextMessage?.text || "").trim();

        const sender = m.key.remoteJid;

        if (sender !== from) return;

        if (text === 'فوق' && game.direction.y !== 1) game.direction = { x: 0, y: -1 };

        else if (text === 'تحت' && game.direction.y !== -1) game.direction = { x: 0, y: 1 };

        else if (text === 'يسار' && game.direction.x !== 1) game.direction = { x: -1, y: 0 };

        else if (text === 'يمين' && game.direction.x !== -1) game.direction = { x: 1, y: 0 };

        else if (text === 'انهاء') game.gameRunning = false;

    };

    sock.ev.on('messages.upsert', messageListener);

    while (game.gameRunning) {

        try {

            // --- تعديل السرعة كل 10 ثوانٍ ---

            const elapsedSeconds = Math.floor((Date.now() - game.startTime) / 1000);

            const speedReductions = Math.floor(elapsedSeconds / 10); // زيادة السرعة كل 10 ثوانٍ

            const currentWait = Math.max(200, 1500 - (speedReductions * 100)); 

            const newHead = {

                x: game.snake[0].x + game.direction.x,

                y: game.snake[0].y + game.direction.y

            };

            if (newHead.x < 0 || newHead.x >= width || newHead.y < 0 || newHead.y >= height) {

                game.gameRunning = false;

                break;

            }

            if (game.snake.some(b => b.x === newHead.x && b.y === newHead.y)) {

                game.gameRunning = false;

                break;

            }

            game.snake.unshift(newHead);

            

            if (newHead.x === game.food.x && newHead.y === game.food.y) {

                game.score += 10;

                let newFood;

                while (true) {

                    newFood = { x: Math.floor(Math.random() * width), y: Math.floor(Math.random() * height) };

                    if (!game.snake.some(b => b.x === newFood.x && b.y === newFood.y)) break;

                }

                game.food = newFood;

            } else {

                game.snake.pop(); 

            }

            await sock.sendMessage(from, { text: drawBoard(currentWait), edit: game.messageKey }).catch(() => {});

            await sleep(currentWait);

        } catch (e) {

            game.gameRunning = false;

        }

    }

    const finalMsg = `💔 *انتهت اللعبة!*\n\n🏆 النتيجة النهائية: ${game.score}\n⏱️ صمدت لمدة: ${Math.floor((Date.now() - game.startTime) / 1000)} ثانية`;

    await sock.sendMessage(from, { text: finalMsg }, { quoted: msg });

    sock.ev.off('messages.upsert', messageListener);

    delete snakeGames[from];

}

export default { NovaUltra, execute };