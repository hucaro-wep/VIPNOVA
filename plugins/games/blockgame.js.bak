import fs from 'fs-extra';

import path from 'path';

const gravityGames = {};

const sleep = ms => new Promise(r => setTimeout(r, ms));

export const NovaUltra = {

    command: 'جاذبية',

    description: 'نسخة النخبة: تمهيد شامل للمسارات 🧹 وتحدي التمساح الأسطوري 🐊.',

    elite: "off",

    group: true,

    prv: false,

    lock: "off"

};

export async function execute({ sock, msg, args }) {

    const from = msg.key.remoteJid;

    if (gravityGames[from] && gravityGames[from].gameRunning) {

        return await sock.sendMessage(from, { text: '⚠️ التحدي قائم بالفعل!' }, { quoted: msg });

    }

    const startAt500 = args.includes('#');

    const width = 10;

    const spawnOffset = 3;

    const playerEmoji = '⬜';

    const fastObstacle = '🦗';

    const crocEmoji = '🐊';

    const fireEmoji = '🔥';

    const warnEmoji = '❗';

    const coinEmoji = '🪙';

    const killVisual = '💥';

    const empty = 'ㅤ';

    gravityGames[from] = {

        playerY: 1, 

        obstacles: [], 

        score: startAt500 ? 500 : 0,

        kills: 0,

        coins: 0,

        speed: startAt500 ? 1000 : 1400,

        gameRunning: true,

        messageKey: null,

        startTime: Date.now(),

        lastObstacleX: 0,

        isEventRunning: false,

        showWarning: false,

        warningLane: 0,

        railArray: Array(width).fill('🟪'),

        lastCrocMilestone: startAt500 ? 0 : 0,

        lastSpeedMilestone: startAt500 ? 2 : 0 

    };

    const game = gravityGames[from];

    const drawBoard = () => {

        let board = `🌌 *تحدي الجاذبية - Anastasia Elite*\n\n`;

        let railStr = game.railArray.join('');

        let lineTop = railStr + '\n'; 

        let lane1 = "";  

        let laneMid = empty.repeat(width) + '\n'; 

        let lane2 = "";  

        let lineBottom = railStr + '\n'; 

        for (let x = 0; x < width; x++) {

            const obs = game.obstacles.find(o => o.x === x);

            const isPlayer = x === 1;

            if (isPlayer && game.playerY === 0) lane1 += playerEmoji;

            else if (obs && obs.type === 0) lane1 += obs.visual || empty;

            else if (game.showWarning && game.warningLane === 0 && x === width - 1) lane1 += warnEmoji;

            else lane1 += empty;

            if (isPlayer && game.playerY === 1) lane2 += playerEmoji;

            else if (obs && obs.type === 1) lane2 += obs.visual || empty;

            else if (game.showWarning && game.warningLane === 1 && x === width - 1) lane2 += warnEmoji;

            else lane2 += empty;

        }

        board += lineTop + lane1 + '\n' + laneMid + lane2 + '\n' + lineBottom + '\n';

        board += `🏆 النتيجة: ${game.score} | 🎯 القتلى: ${game.kills}\n`;

        board += `⚡ السرعة: ${(game.speed / 1000).toFixed(2)}ث | 🪙 العملات: ${game.coins}\n\n`;

        board += `⚔️ *التحكم:* (فوق ، تحت ، قتل)\n🛑 اكتب *انهاء* للانسحاب`;

        return board;

    };

    const initialMsg = await sock.sendMessage(from, { text: drawBoard() });

    game.messageKey = initialMsg.key;

    const messageListener = async ({ messages }) => {

        const m = messages[0];

        if (!m.message || !game.gameRunning || m.key.remoteJid !== from) return;

        const text = (m.message.conversation || m.message.extendedTextMessage?.text || "").trim().toLowerCase();

        if (text === 'فوق' || text === '8') game.playerY = 0;

        else if (text === 'تحت' || text === '2') game.playerY = 1;

        else if (text === 'قتل' || text === '5') {

            const target = game.obstacles.find(o => o.isFast && !o.isExploding && o.x < width);

            if (target) {

                target.isExploding = true;

                target.visual = killVisual;

                target.isDeadly = false;

                target.explosionTime = Date.now();

                game.kills++;

                game.score += 30;

                await sock.sendMessage(from, { text: drawBoard(), edit: game.messageKey }).catch(() => {});

            }

        } else if (text === 'انهاء') game.gameRunning = false;

    };

    sock.ev.on('messages.upsert', messageListener);

    while (game.gameRunning) {

        try {

            // --- 1. فحص ظهور التمساح (تنظيف شامل للجهتين) ---

            const currentCrocMilestone = Math.floor(game.score / 1000);

            if (currentCrocMilestone > game.lastCrocMilestone && !game.isEventRunning) {

                game.lastCrocMilestone = currentCrocMilestone;

                game.isEventRunning = true;

                game.warningLane = Math.random() > 0.5 ? 0 : 1;

                

                // التعديل هنا: مسح كل العوائق والعملات من الجهتين تماماً

                game.obstacles = []; 

                await sleep(2000); 

                for (let i = 0; i < 6; i++) {

                    game.showWarning = !game.showWarning;

                    await sock.sendMessage(from, { text: drawBoard(), edit: game.messageKey }).catch(() => {});

                    await sleep(400);

                }

                game.showWarning = false;

                await sleep(500);

                let crocPos = width + spawnOffset;

                while (crocPos >= -2 && game.gameRunning) {

                    game.obstacles.push({ x: crocPos, type: game.warningLane, visual: fireEmoji, isFire: true, duration: 8, isDeadly: true });

                    if (crocPos >= 0 && crocPos < width) game.railArray[crocPos] = '🟧';

                    crocPos--;

                    game.obstacles = game.obstacles.filter(o => !o.isCroc);

                    game.obstacles.push({ x: crocPos, type: game.warningLane, visual: crocEmoji, isCroc: true, isDeadly: true });

                    await sock.sendMessage(from, { text: drawBoard(), edit: game.messageKey }).catch(() => {});

                    await sleep(100);

                    if (crocPos === 1 && game.warningLane === game.playerY) { game.gameRunning = false; break; }

                }

                game.obstacles = game.obstacles.filter(o => !o.isCroc);

                game.isEventRunning = false;

            }

            // --- 2. التوليد العادي وتمهيد الجرادة ---

            if (!game.isEventRunning) {

                game.lastObstacleX++;

                if (game.lastObstacleX >= 3) {

                    const type = Math.random() > 0.5 ? 0 : 1;

                    const isFast = game.score >= 500 && Math.random() > 0.75;

                    if (isFast) {

                        // تمهيد الجرادة: مسح المسار الخاص بها بالكامل

                        game.obstacles = game.obstacles.filter(o => o.type !== type);

                        game.obstacles.push({ x: width + spawnOffset, type, visual: fastObstacle, isFast: true, isExploding: false, isDeadly: true });

                    } else {

                        game.obstacles.push({ x: width + spawnOffset, type, visual: (type === 0 ? '🔻' : '🔺'), isFast: false, isDeadly: true });

                    }

                    game.lastObstacleX = 0;

                }

                

                if (Math.random() > 0.9) {

                    game.obstacles.push({ x: width + spawnOffset, type: Math.random() > 0.5 ? 0 : 1, visual: coinEmoji, isCoin: true, isDeadly: false });

                }

            }

            await sock.sendMessage(from, { text: drawBoard(), edit: game.messageKey }).catch(() => {});

            await sleep(game.speed);

            game.obstacles = game.obstacles.filter(o => {

                if (o.isExploding) return (Date.now() - o.explosionTime) < 1000;

                if (o.isFire) { o.duration--; return o.duration > 0; }

                o.x -= (o.isFast ? 2 : 1);

                if (o.x === 1 && o.type === game.playerY) {

                    if (o.isCoin) { game.coins++; game.score += 100; return false; }

                    if (o.isDeadly) game.gameRunning = false;

                }

                return o.x >= -2;

            });

            if (!game.gameRunning) break;

            

            game.score += 5;

            if (game.score >= 500) {

                const currentSpeedMilestone = Math.floor(game.score / 200);

                if (currentSpeedMilestone > game.lastSpeedMilestone) {

                    game.speed = Math.max(300, game.speed - 100);

                    game.lastSpeedMilestone = currentSpeedMilestone;

                }

            }

            

            if (!game.isEventRunning) {

                for (let i = 0; i < width; i++) {

                   if (game.railArray[i] === '🟧' && Math.random() > 0.7) game.railArray[i] = '🟪';

                }

            }

        } catch (e) { game.gameRunning = false; }

    }

    const finalMsg = `💀 *انتهت الرحلة!* 💀\n\n🏆 النتيجة: ${game.score}\n🎯 القتلى: ${game.kills} | 🪙 العملات: ${game.coins}`;

    await sock.sendMessage(from, { text: finalMsg }, { quoted: msg });

    sock.ev.off('messages.upsert', messageListener);

    delete gravityGames[from];

}

export default { NovaUltra, execute };